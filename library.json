{
  "name": "wled-usermod-controller",
  "version": "0.1.0",
  "description": "WLED usermod: touch controller (power, preset, brightness) for this WLED and every WLED on the LAN, on a Waveshare ESP32-C6-Touch-LCD-1.47",
  "keywords": [
    "wled",
    "usermod",
    "display",
    "touch",
    "esp32-c6"
  ],
  "authors": [
    {
      "name": "John Meagher"
    }
  ],
  "license": "MIT",
  "build": {
    "libArchive": false,
    "srcFilter": [
      "-<*>",
      "+<controller.cpp>"
    ]
  },
  "dependencies": {
    "adafruit/Adafruit GFX Library": "1.12.1",
    "adafruit/Adafruit BusIO": "1.17.4",
    "adafruit/Adafruit ST7735 and ST7789 Library": "1.11.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jmeagher/wled-usermod-controller.git"
  }
}
